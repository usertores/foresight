{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foresight",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
